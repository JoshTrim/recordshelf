# Create a Discogs personal access token at https://www.discogs.com/settings/developers
GROOVEKEEPER_DISCOGS_TOKEN=replace_with_your_personal_access_token

# Docker Compose settings
GROOVEKEEPER_WEB_PORT=3002
# Registry namespace used by prebuilt container releases.
RECORDSHELF_IMAGE_PREFIX=ghcr.io/your-github-username
# Container tag used by prebuilt GHCR deployments (for example 0.1.0 or latest).
RECORDSHELF_VERSION=latest
# Docker defaults to Ollama; uncomment and set to mistral to use hosted OCR.
# GROOVEKEEPER_VISION_PROVIDER=mistral
GROOVEKEEPER_OLLAMA_MODEL=qwen2.5vl:3b
GROOVEKEEPER_OLLAMA_CONTEXT=2048
GROOVEKEEPER_OLLAMA_NUM_PREDICT=320
GROOVEKEEPER_OLLAMA_KEEP_ALIVE=2m

# Optional hosted OCR provider. Set VISION_PROVIDER=mistral to use it.
GROOVEKEEPER_MISTRAL_API_KEY=
GROOVEKEEPER_MISTRAL_OCR_MODEL=mistral-ocr-latest
GROOVEKEEPER_USER_AGENT=Groovekeeper/1.0 +self-hosted
