# Create a Discogs personal access token at https://www.discogs.com/settings/developers
RECORDSHELF_DISCOGS_TOKEN=replace_with_your_personal_access_token

# Docker Compose settings
RECORDSHELF_WEB_PORT=3002
# Registry namespace used by prebuilt container releases.
RECORDSHELF_IMAGE_PREFIX=ghcr.io/your-github-username
# Container tag used by prebuilt GHCR deployments (for example 0.1.0 or latest).
RECORDSHELF_VERSION=latest
RECORDSHELF_DATA_VOLUME=recordshelf_data
RECORDSHELF_MODEL_VOLUME=recordshelf_models
# Docker defaults to Ollama; uncomment and set to mistral to use hosted OCR.
# RECORDSHELF_VISION_PROVIDER=mistral
RECORDSHELF_OLLAMA_MODEL=qwen2.5vl:3b
RECORDSHELF_OLLAMA_CONTEXT=2048
RECORDSHELF_OLLAMA_NUM_PREDICT=320
RECORDSHELF_OLLAMA_KEEP_ALIVE=2m

# Optional hosted OCR provider. Set RECORDSHELF_VISION_PROVIDER=mistral to use it.
RECORDSHELF_MISTRAL_API_KEY=
RECORDSHELF_MISTRAL_OCR_MODEL=mistral-ocr-latest
RECORDSHELF_USER_AGENT=RecordShelf/1.0 +self-hosted
